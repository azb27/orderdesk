#!/usr/bin/env bash
# Block commits that contain anything shaped like an API key or token (Anthropic, Hugging Face).
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{20,}|hf_[A-Za-z0-9]{30,}'; then
  echo "pre-commit: blocked: staged changes contain what looks like an API key or token." >&2
  echo "Remove it and keep keys in an untracked env file." >&2
  exit 1
fi
